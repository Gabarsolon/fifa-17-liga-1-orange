# Paths to custom CLI alternatives for modding tools.
# Sources (built from decompiled Creation Master 16, DB Master, Frosty Editor):
#   https://github.com/Gabarsolon/CreationMaster16Cli
#   https://github.com/Gabarsolon/DbMasterCli
#   https://github.com/Gabarsolon/FrostyCLI
CMCLI_PATH=C:\path\to\CreationMaster16\CmCli\bin\Debug\CmCli.exe
DBCLI_PATH=C:\path\to\DbMaster\DbCli\bin\Debug\DbCli.exe
# FrostyCmd.exe (FrostyCLI build), invoked as: <exe> FIFA17 import-legacy ...
FROSTYCLI_PATH=C:\path\to\FrostyEditor\bin\Developer\Debug\FrostyCmd.exe

# Decompiled source directories
CM16_DECOMPILED_DIR=C:\path\to\CreationMaster16
DBMASTER_DECOMPILED_DIR=C:\path\to\DbMaster
FROSTY_EDITOR_DECOMPILED_DIR=C:\path\to\FrostyToolsuite

# texconv.exe from https://github.com/microsoft/DirectXTex/releases (PNG -> DDS)
TEXCONV_PATH=C:\path\to\texconv.exe

# FIFA 16 paths
FIFA16_DIR=C:\Program Files (x86)\Origin Games\FIFA 16
FIFA16_DB_PATH=C:\Program Files (x86)\Origin Games\FIFA 16\data\db\fifa_ng_db.db
FIFA16_XML_PATH=C:\Program Files (x86)\Origin Games\FIFA 16\data\db\fifa_ng_db-meta.xml

# FIFA 17 paths
FIFA17_DIR=C:\Program Files (x86)\Origin Games\FIFA 17

# GUI tools (used by open_modding_tools.bat)
FROSTY_EDITOR_PATH=C:\path\to\FrostyEditor.exe
CREATION_MASTER_PATH=C:\Program Files (x86)\Fifa Master\Creation Master 16\CreationMaster16.exe
DB_MASTER_PATH=C:\Program Files (x86)\Fifa Master\DB Master\DbMaster.exe
