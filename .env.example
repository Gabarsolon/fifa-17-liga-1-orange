# Paths to custom CLI alternatives for modding tools
# These CLIs (CmCli, DbCli, FrostyCli) are custom wrappers built on top of 
# the decompiled source code of Creation Master 16, DB Master, and Frosty Editor.
CMCLI_PATH=C:\path\to\decompiled\CreationMaster16\CmCli\bin\Debug\CmCli.exe
DBCLI_PATH=C:\path\to\decompiled\DbMaster\DbCli\bin\Debug\DbCli.exe
FROSTYCLI_PATH=C:\path\to\decompiled\FrostyEditor\FrostyCli\bin\Debug\FrostyCli.exe

# Decompiled Source Directories
CM16_DECOMPILED_DIR=C:\path\to\decompiled\CreationMaster16
DBMASTER_DECOMPILED_DIR=C:\path\to\decompiled\DbMaster
FROSTY_EDITOR_DECOMPILED_DIR=C:\path\to\decompiled\FrostyEditor

# FIFA 16 paths
FIFA16_DIR=C:\Program Files (x86)\Origin Games\FIFA 16
FIFA16_DB_PATH=C:\Program Files (x86)\Origin Games\FIFA 16\data\db\fifa_ng_db.db
FIFA16_XML_PATH=C:\Program Files (x86)\Origin Games\FIFA 16\data\db\fifa_ng_db-meta.xml

# FIFA 17 paths
FIFA17_DIR=C:\Program Files (x86)\Origin Games\FIFA 17
